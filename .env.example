# Application
FLASK_ENV=production
PORT=5000
SECRET_KEY=replace-with-a-long-random-value

# MySQL
DATABASE_URL=mysql+pymysql://fanmilk_user:replace-me@localhost:3306/fanmilk
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-root-password

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=replace-with-your-meta-access-token
WHATSAPP_PHONE_ID=replace-with-your-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-a-random-verification-token
META_APP_SECRET=replace-with-your-meta-app-secret
