# Application
FLASK_ENV=production
PORT=5000
SECRET_KEY=replace-with-a-long-random-value
JWT_SECRET_KEY=replace-with-another-long-random-value
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
RESEND_API_KEY=replace-with-resend-api-key
RESET_EMAIL_FROM=FanMilk Togo <onboarding@resend.dev>
NOTIFICATION_EMAIL_FROM=FanMilk Togo <onboarding@resend.dev>
# Recommandé en production sans domaine Resend : mot de passe d'application Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-gmail-address
SMTP_PASSWORD=replace-with-google-app-password
SMTP_FROM=FanMilk Togo <replace-with-gmail-address>
ADMIN_EMAIL=admin@fanmilk.tg
ADMIN_PASSWORD=replace-with-an-admin-password
DEPOSITAIRE_EMAIL=depositaire@fanmilk.tg
DEPOSITAIRE_PASSWORD=replace-with-a-depositaire-password

# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql+psycopg://fanmilk:replace-with-a-strong-password@postgres:5432/fanmilk

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=replace-with-meta-access-token
WHATSAPP_PHONE_ID=replace-with-phone-number-id
WHATSAPP_VERIFY_TOKEN=replace-with-webhook-verify-token
META_APP_SECRET=replace-with-meta-app-secret
# Modèle Meta approuvé avec un seul paramètre de corps : {{1}}
WHATSAPP_NOTIFICATION_TEMPLATE=alerte_vente_fanmilk
WHATSAPP_NOTIFICATION_LANGUAGE=fr
